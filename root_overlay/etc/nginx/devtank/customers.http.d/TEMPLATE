# This is required to proxy Live WebSocket connections.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

resolver 127.0.0.53;

# Grafana
server {
    server_name CUSTOMERNAME.OSMDOMAIN;
    listen 443 ssl;
    ssl_certificate      "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/fullchain.pem";
    ssl_certificate_key  "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/privkey.pem";

    location / {
        # This stops Grafana origin errors
        proxy_set_header Host $http_host;
        set $endpoint http://CUSTOMERNAME:3000;
        proxy_pass $endpoint;
    }

    location /api/live/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        set $endpoint http://CUSTOMERNAME:3000;
        proxy_pass $endpoint;
    }

}

# Chirpstack
server {
    server_name CUSTOMERNAME-chirpstack.OSMDOMAIN;
    listen 443 ssl;
    ssl_certificate      "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/fullchain.pem";
    ssl_certificate_key  "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/privkey.pem";

    location / {
        # Enable WebSocket proxying required by Chirpstack
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        set $endpoint http://CUSTOMERNAME:8080;
        proxy_pass $endpoint;
    }
}

# MQTT
server {
    server_name CUSTOMERNAME-mqtt.OSMDOMAIN;
    listen 443 ssl;
    ssl_certificate      "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/fullchain.pem";
    ssl_certificate_key  "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/privkey.pem";

    location / {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        set $endpoint http://CUSTOMERNAME:9001;
        proxy_pass $endpoint;
    }
}

# PostgREST
server {
    server_name CUSTOMERNAME-db.OSMDOMAIN;
    listen 443 ssl;
    ssl_certificate      "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/fullchain.pem";
    ssl_certificate_key  "/etc/letsencrypt/live/CUSTOMERNAME.OSMDOMAIN/privkey.pem";

    location / {
        default_type  application/json;
        proxy_hide_header Content-Location;
        add_header Content-Location  /$upstream_http_content_location;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        set $endpoint http://CUSTOMERNAME:3001;
        proxy_pass $endpoint;
    }
}

# Prometheus Node Exporter
server {
    server_name CUSTOMERNAME.OSMDOMAIN;
    listen WG_IP:9110;
    location / {
        set $endpoint http://CUSTOMERNAME:9100;
        proxy_pass $endpoint;
    }
}
