#!/usr/bin/python

from ansible.module_utils.basic import AnsibleModule  # type: ignore
from pyosmorch import DBConnectionOrchestrator, DBConnectionPowerDNS  # type: ignore


def main():
    module_args = dict(
        db_user=dict(type="str", required=True),
        db_password=dict(type="str", required=True, no_log=True),
        db_host=dict(type="str", required=True),
        db=dict(type="str", required=True),


        add_customer=dict(
            type="dict",
            options=dict(
                name=dict(type="str", required=True),
                mqtt_port=dict(type="int", required=True)
            )
        ),
        get_customer_id=dict(),
        get_customer_port=dict(),
        del_customer=dict(),
        add_customer_secret_key=dict(),
        del_customer_secret_key=dict(),
    )

    result = dict(
        changed=False,
        message=""
    )

    supported_queries = [
        'add_customer',
        'del_customer'

    ]

    module = AnsibleModule(
        argument_spec=module_args,
        supports_check_mode=True,
    )

    # if module.params['query'] not in supported_queries:
    #     result['failed'] = True
    #     result['stderr'] = "Unsupported pyosmorch query"
    result['message'] = module.params

    module.exit_json(**result)

if __name__ == '__main__':
    main()
