pipeline {
    agent none
    stages {
        stage('Get OSM sources') {
            agent { label 'vosmhost0-incus' }
            steps {
                dir('/srv/osm-lxc') {
                    checkout scmGit(
                        branches: [[name: 'ref']],
                        userRemoteConfigs: [[url: 'https://git.devtank.co.uk/Devtank/osm-ansible.git']]
                        )

                }
            }

        }
        stage('Run tests') {
            agent { label 'vosmhost0-incus' }
            steps {
                dir('/srv/osm-lxc/orchestrator/env') {
                    ansiColor('xterm') {
                        sh '''
                        stdbuf -oL -eL bats -p --print-output-on-failure --verbose-run -T tests/customers.bats
                        '''
                    }
                }
            }
        }
    }
}
