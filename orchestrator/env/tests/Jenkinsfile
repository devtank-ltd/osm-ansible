pipeline {
    agent none
    stages {
        stage('Wipe out workspace') {
            agent { label 'built-in' }
            steps {
                ansiColor('xterm') {
                    sh './orchestrator/env/tests/jenkins_cleanup_hosts.bash'
                }
            }
        }

        stage('Prepare build') {
            agent { label 'built-in' }
            steps {
                ansiColor('xterm') {
                    sh './orchestrator/env/tests/jenkins_prepare_build.bash'
                }
            }
        }

        stage('Build environment') {
            agent { label 'built-in' }
            environment {
                DEVTANK_BRANCH = "${params.DEVTANK_BRANCH}"
            }
            steps {
                ansiColor('xterm') {
                    sh '''
                    conf="${WORKSPACE}/orchestrator/env/network.cfg"
                    sed -ri 's/(^VOSM_HOSTBR=).*/\\1"'"$BRIDGE_NAME"'"/' "$conf"
                    sed -ri 's/(^OSM_SUBNET=).*/\\1"'"$OSM_SUBNET"'"/' "$conf"
                    sed -ri 's/(^HTTP_PORT=).*/\\1"'"$HTTP_PORT"'"/' "$conf"
                    sed -ri 's/(^OSM_DOMAIN=).*/\\1"'"$OSM_DOMAIN"'"/' "$conf"
                    pushd "${WORKSPACE}/orchestrator/env" >/dev/null 2>&1
                    export ANSIBLE_HOSTS="hosts/hosts"
                    JENKINS_NODE_COOKIE=dontKillMe stdbuf -oL -eL bash run.bash -a setup -c network.cfg
                    '''
                }
            }
        }

        stage('Run tests') {
            agent { label 'built-in' }
            steps {
                ansiColor('xterm') {
                    sh '''
                    pushd "${WORKSPACE}/orchestrator/env"
                    stdbuf -oL -eL bash run.bash --run-tests --hosts-dir=hosts
                    '''
                }
            }
        }
    }

    post {
         changed {
            script {
                if (currentBuild.currentResult == 'FAILURE') {
                    emailext subject: '$DEFAULT_SUBJECT',
                        body: '$DEFAULT_CONTENT',
                        recipientProviders: [
                            [$class: 'CulpritsRecipientProvider'],
                            [$class: 'DevelopersRecipientProvider'],
                            [$class: 'RequesterRecipientProvider']
                        ],
                        replyTo: '$DEFAULT_REPLYTO',
                        to: '$DEFAULT_RECIPIENTS'
                }
            }
        }
    }
}
