pipeline {
    agent none
    stages {
        stage('Wipe out workspace') {
            agent { label 'built-in' }
            steps {
                ansiColor('xterm') {
                    sh '''#!/usr/bin/env bash

                    declare -A VMS
                    declare -a PIDS

                    has() {
                        local want="$1"
                        local x
                        shift

                        for x in "$@"; do
                            [[ "$x" == "$want" ]] && return 0
                        done
                        return 1
                    }

                    for mon in $(find ~+ -type s -name "monitor.sock" -print); do
                        name="${mon%%/monitor.sock}"
                        name="${name##*/}"
                        path="${mon%/*}"
                        VMS["$name"]="$path"
                    done

                    mapfile -t PIDS < <(pgrep -U "$USER" qemu)

                    for name in "${!VMS[@]}"; do
                        qemu_pid="${VMS[$name]}/qemu.pid"
                        if [[ -e "$qemu_pid" ]]; then
                            mapfile -t < "$qemu_pid" pid
                            if has "$pid" "${PIDS[@]}"; then
                                echo "'$name' VM [${pid}] is running..."
                                kill -s SIGTERM "$pid"
                            fi
                        fi
                    done

                    wait_for=5
                    retries=3
                    counter=0

                    for name in "${!VMS[@]}"; do
                        while [[ -u "${VMS[$name]}/qemu.pid" ]]; do
                            mapfile -t < "$qemu_pid" pid
                            sleep $wait_for
                            counter=$(( counter + 1 ))
                            if (( counter > retries )); then
                                kill -s SIGKILL "$pid"
                                if ps "$pid"; then
                                    echo "'$pid' is still running!"
                                    exit 1
                                fi
                            fi
                        done
                    done

                    rm -rf "${WORKSPACE}/orchestrator/env/hosts"
                    '''
                }
            }
        }

        stage('Prepare build') {
            agent { label 'built-in' }
            steps {
                ansiColor('xterm') {
                    sh '''
                    #!/usr/bin/env bash
                    declare -a hosts
                    mapfile -t macs < <(sed -rn 's/dhcp-host=(.*)$/\\1/p' /var/lib/jenkins/dnsmasq_incus_testing.conf)

                    declare -p macs

                    cat /var/lib/jenkins/dnsmasq_incus_testing.conf

                    for record in "${macs[@]}"; do
                        host="${record##*,}"
                        mac="${record%%,*}"
                        n="${host##*.}"

                        if (( ${#n} == 1 )); then
                            name="vosmhost0"
                        else
                            name="vosmhost${n::-1}"
                        fi

                        mkdir -p "${WORKSPACE}/orchestrator/env/hosts/${name}"
                        echo "$mac" > "${WORKSPACE}/orchestrator/env/hosts/${name}/mac"
                    done
                    '''
                }
            }
        }

        stage('Build environment') {
            agent { label 'built-in' }
            environment {
                DEVTANK_BRANCH = "${params.DEVTANK_BRANCH}"
}
            steps {
                ansiColor('xterm') {
                    sh '''
                    conf="${WORKSPACE}/orchestrator/env/network.cfg"
                    sed -ri 's/(^VOSM_HOSTBR=).*/\\1"'"$BRIDGE_NAME"'"/' "$conf"
                    sed -ri 's/(^OSM_SUBNET=).*/\\1"'"$OSM_SUBNET"'"/' "$conf"
                    sed -ri 's/(^HTTP_PORT=).*/\\1"'"$HTTP_PORT"'"/' "$conf"
                    sed -ri 's/(^OSM_DOMAIN=).*/\\1"'"$OSM_DOMAIN"'"/' "$conf"
                    pushd "${WORKSPACE}/orchestrator/env" >/dev/null 2>&1
                    export ANSIBLE_HOSTS="hosts/hosts"
                    JENKINS_NODE_COOKIE=dontKillMe stdbuf -oL -eL bash run.bash -a setup -c network.cfg
                    '''
                }
            }
        }

        stage('Run tests') {
            // agent { label 'vosmhost0-incus' }
            agent { label 'built-in' }
            steps {
                ansiColor('xterm') {
                    sh '''
                    pushd "${WORKSPACE}/orchestrator/env"
                    stdbuf -oL -eL bash run.bash --run-tests --hosts-dir=hosts
                    '''
                }
            }
        }
    }

    post {
         changed {
            script {
                if (currentBuild.currentResult == 'FAILURE') {
                    emailext subject: '$DEFAULT_SUBJECT',
                        body: '$DEFAULT_CONTENT',
                        recipientProviders: [
                            [$class: 'CulpritsRecipientProvider'],
                            [$class: 'DevelopersRecipientProvider'],
                            [$class: 'RequesterRecipientProvider']
                        ],
                        replyTo: '$DEFAULT_REPLYTO',
                        to: '$DEFAULT_RECIPIENTS'
                }
            }
        }
    }
}
