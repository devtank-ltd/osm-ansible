{
  "title": "Container Alert Evaluation Group",
  "folder": "Alerts",
  "interval": 30,
  "rules": [
    {
      "title": "Container Memory Usage",
      "condition": "B",
      "data": [
        {
          "refId": "mem_used",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "DATABASE_UID",
          "model": {
            "disableTextWrap": false,
            "editorMode": "builder",
            "expr": "label_replace(sum by(chart) (netdata_cgroup_mem_usage_limit_MiB_average{dimension=\"used\", family=\"mem\"}), \"chart\", \"$1\", \"chart\", \"cgroup_(.*)\\\\.mem_usage_limit\")",
            "fullMetaSearch": false,
            "includeNullMetadata": true,
            "instant": true,
            "interval": "",
            "intervalMs": 1000,
            "legendFormat": "{{ chart }}",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "mem_used",
            "useBackend": false
          }
        },
        {
          "refId": "mem_avail",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "DATABASE_UID",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "DATABASE_UID"
            },
            "disableTextWrap": false,
            "editorMode": "builder",
            "expr": "label_replace(sum by(chart) (netdata_cgroup_mem_usage_limit_MiB_average{dimension=\"available\", family=\"mem\"}), \"chart\", \"$1\", \"chart\", \"cgroup_(.*)\\\\.mem_usage_limit\")",
            "fullMetaSearch": false,
            "includeNullMetadata": true,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "mem_avail",
            "useBackend": false
          }
        },
        {
          "refId": "cache",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "DATABASE_UID",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "DATABASE_UID"
            },
            "disableTextWrap": false,
            "editorMode": "builder",
            "expr": "label_replace(sum by(chart) (netdata_cgroup_mem_MiB_average{dimension=\"file\", family=\"mem\"}), \"chart\", \"$1\", \"chart\", \"cgroup_(.*)\\\\.mem\")",
            "fullMetaSearch": false,
            "includeNullMetadata": true,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "{{chart}}",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "cache",
            "useBackend": false
          }
        },
        {
          "refId": "Memory Usage Percentage",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    0,
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": []
                },
                "reducer": {
                  "params": [],
                  "type": "avg"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "name": "Expression",
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "100 * (${mem_used} - ${cache}) / (${mem_used} + ${mem_avail})",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Memory Usage Percentage",
            "type": "math"
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    90,
                    0
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": []
                },
                "reducer": {
                  "params": [],
                  "type": "avg"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "name": "Expression",
              "type": "__expr__",
              "uid": "__expr__"
            },
            "expression": "Memory Usage Percentage",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "B",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "labels": {
        "machine-type": "container",
        "stat": "memory"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "Default Contact Point"
      }
    },
    {
      "title": "Container CPU Usage",
      "condition": "Firing",
