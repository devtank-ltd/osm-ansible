        },
        {
          "refId": "Firing",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    80
                  ],
                  "type": "gt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query",
                "unloadEvaluator": {
                  "params": [
                    20
                  ],
                  "type": "lt"
                }
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
