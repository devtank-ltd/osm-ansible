          "model": {
            "disableTextWrap": false,
            "editorMode": "builder",
            "expr": "label_replace(sum by(chart) (avg_over_time(netdata_cgroup_cpu_percentage_average{family=\"cpu\"}[5m])), \"chart\", \"$1\", \"chart\", \"cgroup_(.*)\\\\.cpu\")",
            "fullMetaSearch": false,
            "includeNullMetadata": true,
