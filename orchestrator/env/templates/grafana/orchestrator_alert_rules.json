            "expression": "CPU Usage Percent",
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "Firing",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "2m",
      "labels": {
        "machine-type": "container",
        "stat": "cpu"
      },
      "isPaused": false,
      "notification_settings": {
        "receiver": "Default Contact Point"
      }
    },
